# Playwright
# Scratch screenshots, wherever they are taken from. The leading slash used to
# pin this to the repo root, so a run started inside apps/web committed them.
.playwright-mcp/
/test-results/
/playwright-report/
/apps/web/test-results/
/apps/web/playwright-report/
.env.test

# Saved auth state. tests/e2e/auth.setup.ts regenerates this before every run
# (it creates a throwaway Clerk identity and calls storageState), so it is a
# build artifact, never an input — nothing breaks by not having it.
#
# It was tracked for 12 commits because the rules below pointed at
# `playwright/.auth/`, which is not where this project keeps it. Ignoring the
# whole directory rather than just user.json so a second storage state cannot
# slip in the same way.
/apps/web/tests/e2e/.auth/
# Kept for the default Playwright layout, in case a future package uses it.
**/playwright/.auth/

# Cloudflare
.dev.vars

# design-sync (claude.ai/design)
# Committed: config.json, NOTES.md, conventions.md, previews/, overrides/,
# ds-package/{entry.tsx,PreviewRoot.tsx,env.d.ts,package.json}, tsconfig.*.json.
# Everything below is regenerated by a sync run.
/ds-bundle/
/.ds-sync/
/.design-sync/sb-reference/
/.design-sync/learnings/
/.design-sync/.cache/
/.design-sync/node_modules
/.design-sync/ds-package/types/
/.design-sync/*.log

# Lighthouse CI run output
.lighthouseci
.lighthouseci-mobile
