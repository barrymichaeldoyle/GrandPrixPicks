{
  "name": "@grandprixpicks/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- convex dev",
    "deploy": "convex deploy --yes --typecheck disable",
    "email:dev": "email dev --dir convex/emails --port 3030",
    "lint:queries": "node scripts/check-convex-query-hygiene.mjs",
    "lint": "pnpm run lint:queries && pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/backend/convex",
    "lint:fix": "pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/backend/convex --fix",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "pnpm --dir ../.. exec oxfmt apps/backend",
    "format:check": "pnpm --dir ../.. exec oxfmt --check apps/backend",
    "check": "pnpm run format:check && pnpm run lint",
    "migrations": "node scripts/convex/run-migrations.mjs",
    "migrations:prod": "node scripts/convex/run-migrations.mjs --prod",
    "scenario": "dotenv -e ../../.env.local -- node scripts/convex/testing-scenarios.mjs",
    "smoke:openf1": "node scripts/convex/smoke-openf1.mjs",
    "smoke:openf1:prod": "node scripts/convex/smoke-openf1.mjs --prod",
    "typecheck": "pnpm --dir ../.. --filter @grandprixpicks/shared typecheck && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@convex-dev/resend": "0.2.6",
    "@grandprixpicks/shared": "workspace:*",
    "@react-email/render": "2.1.0",
    "convex": "catalog:",
    "dotenv-cli": "11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.2",
    "@types/react": "19.2.18",
    "@types/web-push": "3.6.4",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  }
}
