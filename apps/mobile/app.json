{
  "expo": {
    "name": "Grand Prix Picks",
    "slug": "grand-prix-picks",
    "scheme": "grandprixpicks",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D4FF3F",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@sentry/react-native",
        {
          "organization": "barry-michael-doyle",
          "project": "grand-prix-picks"
        }
      ],
      "expo-localization",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#101113"
        }
      ],
      "./plugins/withReleasePushEntitlements.cjs"
    ],
    "ios": {
      "bundleIdentifier": "com.barrymichaeldoyle.grandprixpicks",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "EXDevMenuIsOnboardingFinished": true,
        "EXDevMenuShowFloatingActionButton": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "appleTeamId": "LBZ6C9H52C",
      "associatedDomains": ["applinks:grandprixpicks.com"],
      "supportsTablet": false,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.barrymichaeldoyle.grandprixpicks",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101113"
      }
    },
    "extra": {
      "eas": {
        "projectId": "71791ac4-8281-4067-9b8d-f3773f6367b3"
      }
    },
    "owner": "barrymichaeldoyle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101113"
  }
}
