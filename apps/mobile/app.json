{
  "expo": {
    "name": "Grand Prix Picks",
    "slug": "grand-prix-picks",
    "scheme": "grandprixpicks",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D4FF3F",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-localization",
      "./plugins/withSentryPnpmWorkaround.cjs",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#101113"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.barrymichaeldoyle.grandprixpicks",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "appleTeamId": "LBZ6C9H52C",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.barrymichaeldoyle.grandprixpicks",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101113"
      }
    },
    "extra": {
      "eas": {
        "projectId": "71791ac4-8281-4067-9b8d-f3773f6367b3"
      }
    },
    "owner": "barrymichaeldoyle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101113"
  }
}
