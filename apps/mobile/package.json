{
  "name": "@grandprixpicks/mobile",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "generate-tokens": "pnpm --filter @grandprixpicks/shared generate-tokens",
    "dev": "pnpm generate-tokens && expo start --dev-client --host lan",
    "dev:localhost": "pnpm generate-tokens && expo start --dev-client --host localhost",
    "dev:tunnel": "pnpm generate-tokens && expo start --dev-client --tunnel",
    "android": "pnpm generate-tokens && expo run:android",
    "ios": "pnpm generate-tokens && expo run:ios",
    "web": "pnpm generate-tokens && expo start --web",
    "typecheck": "pnpm --dir ../.. --filter @grandprixpicks/shared typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "lint": "pnpm run lint:native-assets && pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/mobile",
    "lint:fix": "pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/mobile --fix",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "pnpm --dir ../.. exec oxfmt apps/mobile",
    "format:check": "pnpm --dir ../.. exec oxfmt --check apps/mobile",
    "check": "pnpm run format:check && pnpm run lint",
    "lint:native-assets": "node scripts/check-native-assets.mjs",
    "prebuild:ios": "pnpm generate-tokens && expo prebuild --platform ios",
    "eas-build-pre-install": "node scripts/check-release-env.mjs"
  },
  "dependencies": {
    "@clerk/expo": "4.14.4",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/vector-icons": "15.1.1",
    "@grandprixpicks/shared": "workspace:*",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@sentry/react-native": "~8.32.0",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-preset-expo": "~58.0.22",
    "clsx": "^2.1.1",
    "convex": "catalog:",
    "convex-helpers": "0.1.129",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.16",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "nativewind": "5.0.0-preview.2",
    "posthog-react-native": "^4.84.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "3.4.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@clerk/expo"
      ]
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "typescript",
        "@sentry/react-native",
        "react-native-gesture-handler"
      ]
    }
  },
  "devDependencies": {
    "@expo/plist": "0.10.1",
    "@types/react": "19.3.0",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  },
  "version": "1.1.0"
}
