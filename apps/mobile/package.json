{
  "name": "@grandprixpicks/mobile",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "generate-tokens": "pnpm --filter @grandprixpicks/shared generate-tokens",
    "dev": "pnpm generate-tokens && expo start --dev-client --host lan",
    "dev:localhost": "pnpm generate-tokens && expo start --dev-client --host localhost",
    "dev:tunnel": "pnpm generate-tokens && expo start --dev-client --tunnel",
    "android": "pnpm generate-tokens && expo run:android",
    "ios": "pnpm generate-tokens && expo run:ios",
    "web": "pnpm generate-tokens && expo start --web",
    "typecheck": "pnpm --dir ../.. --filter @grandprixpicks/shared typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "lint": "pnpm run lint:native-assets && pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/mobile",
    "lint:fix": "pnpm --dir ../.. exec oxlint -c .oxlintrc.json apps/mobile --fix",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "pnpm --dir ../.. exec oxfmt apps/mobile",
    "format:check": "pnpm --dir ../.. exec oxfmt --check apps/mobile",
    "check": "pnpm run format:check && pnpm run lint",
    "lint:native-assets": "node scripts/check-native-assets.mjs",
    "prebuild:ios": "pnpm generate-tokens && expo prebuild --platform ios",
    "eas-build-pre-install": "node scripts/check-release-env.mjs"
  },
  "dependencies": {
    "@clerk/expo": "4.6.6",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/vector-icons": "15.1.1",
    "@grandprixpicks/shared": "workspace:*",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@sentry/react-native": "~8.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-preset-expo": "~57.0.11",
    "clsx": "^2.1.1",
    "convex": "catalog:",
    "convex-helpers": "0.1.124",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.0",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "5.0.0-preview.2",
    "posthog-react-native": "^4.68.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@clerk/expo"
      ]
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "typescript",
        "@sentry/react-native",
        "react-native-gesture-handler"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  },
  "version": "1.0.0"
}
