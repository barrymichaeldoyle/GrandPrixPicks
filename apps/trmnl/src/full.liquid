{% if has_race %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  {% render "race_header", race: race, name_size: "lg:title--xlarge", detail_size: "lg:label--large", flag_size: "h--[56px] w--max-[112px] lg:h--[96px] lg:w--max-[192px]" %}
  {% comment %}
    Two columns side by side, stacked in portrait: side by side on a portrait
    X they squeezed every name and time onto two lines and left the bottom
    half empty.
  {% endcomment %}
  <div class="grid grid--cols-2 portrait:grid--cols-1 gap--large grow">
    <div class="flex flex--col flex--stretch-x gap--small">
      {% comment %}
        On race morning the grid fills the right column, so the code sits
        beside the lead instead; under the timeline it overflowed the OG.
      {% endcomment %}
      {% if focus == "grid" %}
      <div class="flex flex--row flex--center-y gap--medium">
        <div class="grow flex flex--col flex--center gap--xsmall">
          {% render "lead", lead: lead, size: "value--large lg:value--xxlarge" %}
          {% render "lead_weather", weather: lead.weather %}
        </div>
        {% render "qr", url: race.url %}
      </div>
      {% else %}
      <div class="flex flex--col flex--center gap--xsmall">
        {% render "lead", lead: lead, size: "value--large lg:value--xxlarge" %}
        {% render "lead_weather", weather: lead.weather %}
      </div>
      {% endif %}
      {% comment %}No weather line: each timeline row carries its own forecast.{% endcomment %}
      {% render "schedule", schedule: schedule, size: "table--small lg:table--large", name: "label" %}
    </div>
    <div class="flex flex--col flex--stretch-x gap--small h--full">
      {% comment %}
        The focus block takes the column's spare height and the QR code sits
        under it at the bottom. The spare height has to belong to the block
        itself: TRMNL's overflow script hides news items that do not fit, and
        a separate spacer would read to it as content.
      {% endcomment %}
      <div class="grow">
        {% if focus == "result" %}
          {% render "result", result: result, limit: 10, split: true %}
        {% elsif focus == "grid" %}
          {% render "grid", grid: grid %}
        {% elsif focus == "news" %}
          {% render "news", news: news, limit: 4, headline_size: "title--base lg:title--xlarge" %}
        {% endif %}
      </div>
      {% unless focus == "grid" %}{% render "qr", url: race.url %}{% endunless %}
    </div>
  </div>
</div>
{% elsif standings %}
{% comment %}
  The off-season: the season's two tables and the news, three columns. In
  portrait the tables share the top and the news runs beneath them.
{% endcomment %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  {% render "standings_header", standings: standings, title_size: "lg:title--xlarge", detail_size: "lg:label--large" %}
  <div class="grid grid--cols-3 portrait:grid--cols-2 gap--large grow">
    {% render "standings_table", label: "Drivers", rows: standings.drivers, limit: 10, size: "table--xsmall lg:table--base" %}
    {% render "standings_table", label: "Constructors", rows: standings.constructors, limit: 10, size: "table--xsmall lg:table--base" %}
    <div class="flex flex--col portrait:flex--row flex--stretch-x gap--small h--full portrait:col--span-2">
      <div class="grow">
        {% render "news", news: news, limit: 3, headline_size: "title--small lg:title--large" %}
      </div>
      {% render "qr", url: standings.url %}
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title">No race scheduled.</span>
</div>
{% endif %}
{% render "title_bar", race: race %}
