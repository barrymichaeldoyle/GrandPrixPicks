{% if has_race %}
{% assign full_news_size = "title--base lg:title--large" %}
{% if news.size > 6 %}{% assign full_news_size = "title--small lg:title--base" %}{% endif %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  <div class="flex flex--row flex--center-y gap--medium">
    <div class="grow">
      {% render "race_header", race: race, name_size: "title--large portrait:title--small lg:text--xxxlarge lg:portrait:text--large", detail_size: "label--base portrait:label--small lg:label--xlarge lg:portrait:label--base", flag_size: "h--[56px] w--max-[112px] lg:h--[96px] lg:w--max-48", compact_details: true %}
    </div>
    <div class="flex-none">{% render "qr", url: race.url, size_class: "w--[56px] h--[56px] lg:w--[96px] lg:h--[96px]" %}</div>
  </div>
  {% comment %}
    Two columns side by side, stacked in portrait: side by side on a portrait
    X they squeezed every name and time onto two lines and left the bottom
    half empty.
  {% endcomment %}
  <div class="grid grid--cols-2 portrait:grid--cols-1 gap--large grow">
    <div class="flex flex--col flex--stretch-x gap--auto">
      <div class="flex flex--col flex--center gap--xsmall">
        {% render "lead", lead: lead, size: "value--large lg:value--xxlarge", label_size: "lg:text--mega" %}
        {% render "lead_weather", weather: lead.weather, text_size: "lg:label--xlarge", temp_first: true %}
      </div>
      {% comment %}
        A whole number of squares scaled to the column, so the band never ends
        on a cut square. An odd count puts a black square in both top corners;
        the height follows the width so the squares stay square. Portrait's
        full-width column takes more of them, or the band grows to 58px on an X.
      {% endcomment %}
      <div class="w--full portrait:hidden" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 376 16" width="100%" style="display: block; height: auto;" shape-rendering="crispEdges" role="presentation">
          <defs><pattern id="schedule-checker" width="16" height="16" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#000"/><rect x="8" width="8" height="8" fill="#fff"/><rect y="8" width="8" height="8" fill="#fff"/><rect x="8" y="8" width="8" height="8" fill="#000"/></pattern></defs>
          <rect width="376" height="16" fill="url(#schedule-checker)"/>
        </svg>
      </div>
      <div class="w--full hidden portrait:block" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 472 16" width="100%" style="display: block; height: auto;" shape-rendering="crispEdges" role="presentation">
          <defs><pattern id="schedule-checker-portrait" width="16" height="16" patternUnits="userSpaceOnUse"><rect width="8" height="8" fill="#000"/><rect x="8" width="8" height="8" fill="#fff"/><rect y="8" width="8" height="8" fill="#fff"/><rect x="8" y="8" width="8" height="8" fill="#000"/></pattern></defs>
          <rect width="472" height="16" fill="url(#schedule-checker-portrait)"/>
        </svg>
      </div>
      {% comment %}No weather line: each timeline row carries its own forecast.{% endcomment %}
      {% render "schedule", schedule: schedule, size: "table--small lg:table--large", name: "label", aligned: true %}
    </div>
    <div class="flex flex--col flex--stretch-x gap--small h--full">
      {% comment %}
        The focus block takes the column's spare height. TRMNL's overflow
        script hides news items that do not fit, and a separate spacer would
        read to it as content.
      {% endcomment %}
      <div class="grow {% if focus == 'result' or focus == 'standings' %}flex flex--col flex--stretch-x flex--center-y h--full{% elsif news.size == 0 and focus != 'grid' %}h--full{% endif %}">
        {% if focus == "result" %}
          {% render "result", result: result, limit: 10, split: true %}
        {% elsif focus == "standings" %}
          {% comment %}Stacked under the timeline in portrait, where ten rows do not fit.{% endcomment %}
          <div class="portrait:hidden">{% render "championship", rows: standings.drivers, limit: 10, size: "table--xsmall lg:table--large" %}</div>
          <div class="hidden portrait:block">{% render "championship", rows: standings.drivers, limit: 5, size: "table--xsmall lg:table--base" %}</div>
        {% elsif focus == "grid" %}
          {% render "grid", grid: grid %}
        {% elsif focus == "news" %}
          {% comment %}
            Cap headlines for the physical screen size. The overflow script
            left the last two-line item partly under the title bar on the OG.
          {% endcomment %}
          <div class="grow lg:hidden">
            {% render "news", news: news, limit: 7, headline_size: full_news_size, fill: true, empty_size: "lg:label--large" %}
          </div>
          <div class="grow hidden lg:block lg:portrait:hidden">
            {% render "news", news: news, limit: 11, headline_size: full_news_size, fill: true, empty_size: "lg:label--large" %}
          </div>
          <div class="grow hidden lg:portrait:block">
            {% render "news", news: news, limit: 10, headline_size: full_news_size, fill: true, empty_size: "lg:label--large" %}
          </div>
        {% elsif news.size == 0 %}
          {% render "news", news: news, limit: 1, headline_size: full_news_size, fill: true, empty_size: "lg:label--large" %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% elsif standings %}
{% comment %}
  The off-season: 22 drivers in two columns, and all 11 constructors in the
  third. One headline and the QR code sit beside the heading so neither can
  be pushed below the screen by the tables. In portrait, constructors follow
  the drivers.
{% endcomment %}
<div class="layout layout--col layout--top layout--stretch-x gap--small">
  <div class="flex flex--row flex--center-y gap--medium portrait:hidden">
    <div class="grow flex flex--col flex--left flex--stretch-x gap--small">
      {% render "standings_header", standings: standings, title_size: "lg:title--xlarge", detail_size: "lg:label--large" %}
      {% render "news", news: news, limit: 1, headline_size: "title--small lg:title--base" %}
    </div>
    {% render "qr", url: standings.url %}
  </div>
  <div class="hidden portrait:block">
    <div class="flex flex--row flex--center-y gap--small">
      <div class="grow">{% render "standings_header", standings: standings, title_size: "lg:title--xlarge", detail_size: "lg:label--large" %}</div>
      <div class="flex-none">{% render "qr", url: standings.url %}</div>
    </div>
    {% if news.size > 0 %}{% render "news", news: news, limit: 1, headline_size: "title--small lg:title--base" %}{% endif %}
  </div>
  <div class="grid grid--cols-3 portrait:grid--cols-2 gap--medium grow">
    <div class="flex flex--col flex--stretch-x flex--center-y gap--xsmall col--span-2">
      <span class="title title--small lg:title--base">Drivers</span>
      <div class="grid grid--cols-2 gap--medium">
        {% render "standings_table", label: "", rows: standings.drivers, limit: 11, offset: 0, size: "table--xsmall lg:table--small" %}
        {% render "standings_table", label: "", rows: standings.drivers, limit: 11, offset: 11, size: "table--xsmall lg:table--small" %}
      </div>
    </div>
    <div class="flex flex--col flex--stretch-x flex--center-y h--full">
      {% render "standings_table", label: "Constructors", rows: standings.constructors, limit: 11, offset: 0, size: "table--xsmall lg:table--small" %}
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title">No race scheduled.</span>
</div>
{% endif %}
{% render "title_bar", race: race %}
