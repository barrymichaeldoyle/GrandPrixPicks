{% if has_race %}
{% assign half_vertical_news_size = "title--small lg:title--base" %}
{% if news.size > 3 %}{% assign half_vertical_news_size = "title--small lg:title--small" %}{% endif %}
{% assign half_vertical_body_center = "" %}
{% if news.size == 0 %}{% assign half_vertical_body_center = "flex--center-y" %}{% endif %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  <div class="flex flex--row flex--center-y gap--medium w--full portrait:hidden">
    <div class="grow">{% render "race_header", race: race, name_size: "lg:title--large", detail_size: "lg:label--large", flag_size: "h--[28px] w--max-[56px] lg:h--[36px] lg:w--max-[72px]", inline_flag: true %}</div>
    <div class="flex-none">{% render "qr", url: race.url %}</div>
  </div>
  <div class="hidden portrait:block w--full">
    <div class="flex flex--row flex--center-y gap--small w--full">
      <div class="grow">{% render "race_header", race: race, name_size: "lg:title--large", detail_size: "lg:label--large", flag_size: "h--[28px] w--max-[56px] lg:h--[36px] lg:w--max-[72px]", inline_flag: true %}</div>
      <div class="flex-none">{% render "qr", url: race.url %}</div>
    </div>
  </div>
  <div class="flex flex--row flex--center-y gap--medium">
    <div class="grow flex flex--col flex--center gap--xsmall">
      {% render "lead", lead: lead, size: "value--large lg:value--large" %}
      {% render "lead_weather", weather: lead.weather %}
    </div>
  </div>
  {% if focus == "result" %}
    {% comment %}
      Two columns of five in landscape; one column of ten in portrait, where
      the half is tall and narrow and two columns wrapped every name.
    {% endcomment %}
    <div class="grow flex flex--col flex--stretch-x flex--center-y portrait:hidden">{% render "result", result: result, limit: 10, split: true %}</div>
    <div class="grow hidden portrait:block">
      <div class="flex flex--col flex--stretch-x flex--center-y h--full">{% render "result", result: result, limit: 10, split: false %}</div>
    </div>
  {% else %}
    {% comment %}
      The landscape OG has room for three schedule rows and one headline.
      More rows start below the title bar before overflow management can
      hide them. The taller portrait slot and the X can carry more.
    {% endcomment %}
    <div class="grow portrait:hidden lg:hidden">
      <div class="flex flex--col flex--stretch-x gap--auto h--full {{ half_vertical_body_center }}">
        {% render "schedule", schedule: schedule, limit: 3, tail: true, size: "table--small", name: "short" %}
        {% if news.size > 0 %}{% render "news", news: news, limit: 1, headline_size: half_vertical_news_size %}{% endif %}
      </div>
    </div>
    <div class="grow hidden portrait:block lg:portrait:hidden">
      <div class="flex flex--col flex--stretch-x gap--auto h--full {{ half_vertical_body_center }}">
        {% render "schedule", schedule: schedule, limit: 4, tail: true, size: "table--small", name: "short" %}
        {% if news.size > 0 %}{% render "news", news: news, limit: 3, headline_size: half_vertical_news_size %}{% endif %}
      </div>
    </div>
    <div class="grow hidden lg:block">
      <div class="flex flex--col flex--stretch-x gap--auto h--full {{ half_vertical_body_center }}">
        {% render "schedule", schedule: schedule, limit: 4, tail: true, size: "table--base", name: "short" %}
        {% if news.size > 0 %}{% render "news", news: news, limit: 3, headline_size: half_vertical_news_size %}{% endif %}
      </div>
    </div>
  {% endif %}
</div>
{% elsif standings %}
<div class="layout layout--col layout--top layout--stretch-x gap--medium">
  <div class="flex flex--row flex--center-y gap--medium portrait:hidden">
    <div class="grow">
      {% render "standings_header", standings: standings, title_size: "lg:title--large", detail_size: "lg:label--large" %}
    </div>
    {% render "qr", url: standings.url %}
  </div>
  <div class="hidden portrait:block">
    {% render "standings_header", standings: standings, title_size: "lg:title--large", detail_size: "lg:label--large" %}
    {% render "qr", url: standings.url %}
  </div>
  <div class="grow flex flex--col flex--stretch-x gap--auto">
    {% render "standings_table", label: "Drivers", rows: standings.drivers, limit: 10, offset: 0, size: "table--small portrait:table--xsmall lg:table--large lg:portrait:table--small" %}
    {% comment %}
      The constructors only fit under the drivers on the tall portrait half,
      and on a portrait X only at the smaller row height.
    {% endcomment %}
    <div class="hidden portrait:block">
      {% render "standings_table", label: "Constructors", rows: standings.constructors, limit: 10, offset: 0, size: "table--small portrait:table--xsmall lg:table--large lg:portrait:table--small" %}
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title">No race scheduled.</span>
</div>
{% endif %}
{% render "title_bar", race: race %}
