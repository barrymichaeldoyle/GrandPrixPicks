{% comment %}The Theme setting: dark paints this plugin's own view, never the rest of a mashup.{% endcomment %}
{% assign theme = trmnl.plugin_settings.custom_fields_values.theme %}
{% if theme == "dark" %}{% assign dark_classes = "inverse bg--canvas " %}{% endif %}
{% if has_race and race %}
{% comment %}The narrow portrait quarter stacks the QR below the race header.{% endcomment %}
<div class="{{ dark_classes }}layout layout--col layout--top layout--stretch-x gap--none">
  <div class="flex flex--row flex--center-y gap--small w--full portrait:hidden">
    <div class="grow">{% render "race_header", race: race, name_size: "title--small lg:title--base", detail_size: "lg:label--base", flag_size: "h--[24px] w--max-[48px] lg:h--[32px] lg:w--max-[64px]", inline_flag: true, theme: theme %}</div>
    <div class="flex-none">{% render "qr", url: race.url %}</div>
  </div>
  <div class="hidden portrait:block w--full">
    {% render "race_header", race: race, name_size: "title--small lg:title--base", detail_size: "lg:label--base", flag_size: "h--[24px] w--max-[48px] lg:h--[32px] lg:w--max-[64px]", inline_flag: true, split_dates: true, theme: theme %}
    {% render "qr", url: race.url %}
  </div>
  <div class="grow flex flex--col flex--stretch-x gap--auto">
    <div class="flex-none flex flex--col flex--center gap--none">
      {% if between_rounds and upcoming.size > 0 %}
        <div class="w--full portrait:hidden lg:portrait:block">{% render "upcoming", upcoming: upcoming, limit: 2, size: "table--xsmall", title_size: "title--small" %}</div>
        <div class="w--full hidden portrait:block lg:portrait:hidden">{% render "upcoming", upcoming: upcoming, limit: 2, title_size: "title--small", stacked: true %}</div>
      {% else %}
      {% render "lead", lead: lead, size: "value--small portrait:value--medium lg:value--large" %}
      {% comment %}
        No wind on the landscape OG: with the rainfall it ran 2px past the
        quarter and wrapped the wind inside itself, and stacked it pushed the
        headline under the title bar. With no timeline here, rain says more.
      {% endcomment %}
      <div class="w--full lg:hidden portrait:hidden">{% render "lead_weather", weather: lead.weather, rain_amount: true, no_wind: true, theme: theme %}</div>
      <div class="w--full hidden lg:block portrait:block">{% render "lead_weather", weather: lead.weather, rain_amount: true, stack: "portrait:", theme: theme %}</div>
      {% endif %}
    </div>
    {% if news.size > 0 %}
      <div class="portrait:hidden lg:hidden">
        {% render "news", news: news, limit: 1, headline_size: "title--small" %}
      </div>
      <div class="hidden portrait:block lg:portrait:hidden">
        {% render "news", news: news, limit: 1, headline_size: "title--small", clamp: 3 %}
      </div>
      <div class="hidden lg:block lg:portrait:hidden">
        {% render "news", news: news, limit: 1, headline_size: "title--small lg:title--base" %}
      </div>
      <div class="hidden lg:portrait:block">
        {% render "news", news: news, limit: 2, headline_size: "title--small lg:title--base" %}
      </div>
    {% endif %}
  </div>
</div>
{% elsif standings %}
<div class="{{ dark_classes }}layout layout--col layout--top layout--stretch-x gap--small">
  <div class="flex flex--row flex--center-y gap--small w--full">
    <div class="grow">{% render "standings_header", standings: standings, title_size: "portrait:title--small lg:title--base", detail_size: "lg:label--base" %}</div>
    <div class="flex-none">{% render "qr", url: standings.url %}</div>
  </div>
  <div class="grow flex flex--row portrait:flex--col flex--center-y gap--medium w--full">
    <div class="grow flex flex--col flex--center gap--xsmall">
      {% render "leader", standings: standings, value_size: "value--small lg:value--medium" %}
      {% if standings.constructors.first.name != blank %}
      <span class="label label--small lg:label--base w--full" data-clamp="1">Constructors: {{ standings.constructors.first.name }}</span>
      {% endif %}
    </div>
  </div>
</div>
{% else %}
<div class="{{ dark_classes }}layout layout--col layout--center">
  <span class="title title--small">No race scheduled.</span>
</div>
{% endif %}
{% render "title_bar", race: race, theme: theme %}
