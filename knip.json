{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreFiles": [
    ".agents/**",
    // Tooling for the claude.ai/design sync, none of which is imported by the
    // app: `check-spec-drift.mjs` is run by hand (see .design-sync/spec/README.md)
    // and `ds-package/*` are entry points the sync's own build consumes.
    ".design-sync/**"
  ],
  "ignoreIssues": {
    "apps/web/src/integrations/tanstack-query/root-provider.tsx": ["exports"],
    "apps/web/src/lib/og/templates.ts": ["exports"]
  },
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/start.ts",
        "instrument.server.mjs",
        "server/routes/**/*.ts",
        "server/middleware/**/*.ts",
        "server/error.ts",
        // Playwright specs are entry points: nothing imports them, the runner
        // discovers them. Without this the e2e tree is invisible to knip, and
        // a dependency only the specs use reads as unused.
        "tests/e2e/**/*.spec.ts",
        "tests/e2e/**/*.setup.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "server/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": ["@tanstack/router-plugin", "tailwindcss"],
      "ignoreBinaries": ["cloudflared"]
    },
    "apps/backend": {
      "entry": ["convex/**/*.ts"],
      "project": ["convex/**/*.ts"]
    },
    "apps/mobile": {
      "entry": ["App.tsx"],
      "project": ["**/*.{ts,tsx,js,cjs}"],
      "ignoreFiles": ["babel.config.cjs"],
      "ignoreDependencies": ["expo-updates", "tailwind-merge", "clsx"],
      "ignore": ["src/tw/index.tsx", "plugins/*.cjs"]
    },
    "apps/reddit": {
      "entry": [
        "src/client/game.tsx",
        "src/client/splash.tsx",
        "src/server/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreFiles": ["src/client/global.ts"],
      "ignoreDependencies": ["@grandprixpicks/shared", "tailwindcss"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
